// Y CRM — Prisma schema
// To regenerate the client after changes: npx prisma generate
// To push schema to database: npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  hashedPassword String? // Nullable for migration
  role           String   @default("user") // "admin" | "user"
  color          String // hex color for owner indicator (e.g. "#deff00")
  initial        String // single letter for owner dot (e.g. "N")
  createdAt      DateTime @default(now())

  ownedDeals          Deal[]     @relation("DealOwner")
  ownedCompanies      Company[]  @relation("CompanyOwner")
  signalStatusChanges Signal[]   @relation("SignalStatusBy")
  activities          Activity[]
  targets             Target[]
  accounts            Account[]
  sessions            Session[]

  @@map("users")
}

model Stage {
  id     String  @id @default(cuid())
  name   String
  order  Int
  // null status = open pipeline stage. "won" / "lost" = terminal stages.
  status String?

  deals Deal[]

  @@unique([order])
  @@map("stages")
}

// CRM: Company (Företagsregister)
model Company {
  id            String  @id @default(cuid())
  name          String // Original case preserved
  nameNorm      String // Normalized for duplicate detection (lowercase, trimmed)
  orgNr         String? @unique // Organization number (XXXXXX-XXXX), primary duplicate key
  industry      String? // Bransch
  website       String?
  address       String?
  city          String? // Ort
  region        String? // "Västra Götaland" | "Övriga Sverige" | "Okänd"
  employees     Int? // Number of employees
  employeesNote String? // Raw/uncertain headcount, e.g. "ca 130–150", "okänt"
  switchboard   String? // Växel
  email         String? // General published address, e.g. info@
  emailPattern  String? // Published pattern, e.g. fornamn.efternamn@bolag.se — never a real address
  notes         String? @db.Text

  // Ansvarig for the company / prospect
  ownerId String?
  owner   User?   @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // Financial profile (Ledarskapsradarn) — from the latest annual report. Amounts in MSEK, ratios in %.
  fiscalYear              Int? // Bokslutsår the figures refer to
  revenueMsek             Float? // Omsättning
  operatingProfitMsek     Float? // Rörelseresultat, latest year
  operatingProfitPrevMsek Float? // Rörelseresultat, year before
  operatingMarginPct      Float? // Rörelsemarginal
  equityRatioPct          Float? // Soliditet
  quickRatioPct           Float? // Kassalikviditet
  managers                Int? // Number of managers/leaders, when published
  distanceKm              Int? // Override for distance to Göteborg; otherwise derived from city

  // Glappanalys (Kulturradarn): ambition vs. how well the values drive it. A hypothesis, not a diagnosis.
  gapAmbition   Int? // 1-3
  gapDrive      Int? // 1-3 (värderingarnas drivkraft)
  gapRationale  String?   @db.Text
  gapAssessedAt DateTime?

  contacts   Contact[]
  deals      Deal[]
  signals    Signal[]
  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nameNorm])
  @@index([nameNorm])
  @@index([ownerId])
  @@map("companies")
}

// CRM: Contact (Kontaktpersoner)
model Contact {
  id        String  @id @default(cuid())
  firstName String
  lastName  String
  fullName  String // For search/display
  title     String? // Job title (e.g. "Inköpschef")
  email     String?
  phone     String?
  linkedin  String?
  sourceUrl String? // Where the contact details were published (Kulturradarn rule)
  notes     String? @db.Text

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  deals        Deal[]
  participants Participant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([email])
  @@map("contacts")
}

model Deal {
  id    String @id @default(cuid())
  title String

  // NEW: Normalized relations (optional during migration)
  companyId   String?
  company_rel Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  contactId   String?
  contact_rel Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // OLD: Kept as backup during migration (will be removed later)
  company String?
  contact String?
  email   String?
  phone   String?

  value  Int     @default(0) // value in SEK (no decimals)
  notes  String?
  status String  @default("open") // open | won | lost

  stageId String
  stage   Stage  @relation(fields: [stageId], references: [id])

  ownerId String
  owner   User   @relation("DealOwner", fields: [ownerId], references: [id])

  // Optional metadata kept from Pipedrive import for reference
  source   String? // e.g. "pipedrive-import"
  sourceId String? // original Pipedrive deal ID

  wonAt             DateTime? // when the deal was marked won
  lostAt            DateTime? // when the deal was marked lost
  expectedCloseDate DateTime? // for forecasting

  // Planned activity / reminder (one per deal). reminderAt stored at noon UTC.
  reminderAt   DateTime? // when the planned activity is due (e.g. "call on Wednesday")
  reminderNote String? // optional note, e.g. "Ring – satt illa till"

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[]
  emailLogs  EmailLog[]

  @@index([stageId])
  @@index([ownerId])
  @@index([wonAt])
  @@index([companyId])
  @@index([contactId])
  @@index([projectId])
  @@map("deals")
}

model Activity {
  id         String   @id @default(cuid())
  type       String // note | call | email | meeting
  content    String   @db.Text
  occurredAt DateTime @default(now())

  // An activity belongs to a deal, or directly to a company (e.g. a radar prospect not yet in the pipeline)
  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([dealId])
  @@index([companyId])
  @@map("activities")
}

// Sales targets. userId=null means a company-wide target.
// month=null means a yearly target. month=1-12 means a monthly target.
model Target {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  year      Int
  month     Int? // 1-12, or null for yearly target
  amount    Int // SEK
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year, month])
  @@index([year])
  @@map("targets")
}

// NextAuth.js tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Project {
  id                  String    @id @default(cuid())
  // "ledarskapsprogram" = course with participants/price/sessions.
  // "vardegrundsarbete" = engagement planned as free-form activities (milestones).
  type                String    @default("ledarskapsprogram")
  name                String
  startDate           DateTime
  endDate             DateTime? // planned end — draws the bar on the timeline/gantt view
  value               Int       @default(0) // affärsvärde (SEK) — total contract value of the project
  format              String?   @db.Text
  location            String? // Physical location for sessions
  maxParticipants     Int
  pricePerParticipant Int
  status              String    @default("planned")
  isFavorite          Boolean   @default(false) // pinned to the dashboard for fill-rate tracking
  notes               String?   @db.Text

  deals        Deal[]
  participants Participant[]
  sessions     ProjectSession[]
  milestones   Milestone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startDate])
  @@map("projects")
}

// A deliverable / phase within a project (delleverans), shown as a point on the
// project's timeline. Marked done as the project progresses; editable and can be
// added along the way (e.g. on upsell or scope changes).
model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  date        DateTime // planned delivery date — position on the timeline
  status      String    @default("planned") // "planned" | "done"
  completedAt DateTime? // when it was marked done
  order       Int       @default(0) // manual ordering for same-day / undated grouping
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
  @@index([date])
  @@map("milestones")
}

model Participant {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status         String   @default("confirmed")
  invoicedAmount Int      @default(0)
  isPaid         Boolean  @default(false)
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projectId, contactId])
  @@index([projectId])
  @@index([contactId])
  @@index([status])
  @@map("participants")
}

model ProjectSession {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date      DateTime // Session date
  startTime String // e.g. "09:00"
  endTime   String // e.g. "12:30"
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([date])
  @@map("project_sessions")
}

model EmailLog {
  id String @id @default(cuid())

  // Email metadata
  from       String // sender email
  to         String // recipient email
  subject    String   @db.Text
  body       String   @db.Text
  bodyHtml   String?  @db.Text
  receivedAt DateTime @default(now())

  // Matching status
  status        String  @default("pending") // pending | matched | ignored
  matchedDealId String?
  matchedDeal   Deal?   @relation(fields: [matchedDealId], references: [id], onDelete: SetNull)

  // Raw email data (for debugging)
  rawHeaders String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([from])
  @@index([receivedAt])
  @@map("email_logs")
}

// Kulturradarn: a market signal suggesting a company's culture may be chafing
// against its development. A company can collect many signals over time.
model Signal {
  id        String  @id @default(cuid())
  radar     String  @default("kultur") // "kultur" | "ledarskap"
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type       String // One of RADAR_SIGNAL_TYPES (src/lib/radar.ts)
  summary    String  @db.Text // 1–2 sentences on what happened
  eventDate  String? // "ÅÅÅÅ-MM" or "ÅÅÅÅ" as published
  sourceName String?
  sourceUrl  String?
  strength   String? // "Hög" | "Medel" | "Låg"
  angle      String? @db.Text // Suggested way in (vinkel)

  // Triage — set by humans only, never by automation
  status          String    @default("Ny") // "Ny" | "Bevaka" | "Kontaktad" | "Ej relevant"
  statusChangedAt DateTime?
  statusById      String?
  statusBy        User?     @relation("SignalStatusBy", fields: [statusById], references: [id], onDelete: SetNull)

  // Raw inbox row this signal came from (one signal per inbox row)
  inboxId String?     @unique
  inbox   RadarInbox? @relation(fields: [inboxId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([radar])
  @@index([status])
  @@index([type])
  @@map("signals")
}

// Kulturradarn landing table. The weekly harvest (claude.ai scheduled task via
// Supabase SQL) only INSERTs here; the CRM processes rows into Company/Contact/Signal.
// Column names match the radar export so the harvest prompt can write them as-is.
// ids/timestamps are DB-generated so plain SQL inserts work.
model RadarInbox {
  id                    String  @id @default(dbgenerated("(gen_random_uuid())::text"))
  radar                 String  @default("kultur") // "kultur" | "ledarskap"
  slug                  String? // Company name slug from the harvest, e.g. "xl-bygg-herrljunga"
  typ                   String
  bolag                 String
  orgnr                 String?
  ort                   String?
  bransch               String?
  region                String?
  anstallda             String?
  signal                String  @db.Text
  datum                 String?
  kalla                 String?
  url                   String?
  styrka                String?
  vinkel                String? @db.Text
  kontakt               String?
  kontaktRoll           String? @map("kontakt_roll")
  telefon               String?
  vaxel                 String?
  epost                 String?
  epostMonster          String? @map("epost_monster")
  kontaktKalla          String? @map("kontakt_kalla")
  kontaktKommentar      String? @map("kontakt_kommentar") @db.Text
  ambition              Int? // Glappanalys 1-3 (optional, when built)
  drivkraft             Int? // Glappanalys 1-3
  glappMotivering       String? @map("glapp_motivering") @db.Text
  // Ledarskapsradarn: financial profile from the latest annual report (MSEK / %)
  bokslutsar            Int?
  omsattningMsek        Float?  @map("omsattning_msek")
  rorelseresultatMsek   Float?  @map("rorelseresultat_msek")
  rorelseresultatFgMsek Float?  @map("rorelseresultat_fg_msek")
  rorelsemarginal       Float?
  soliditet             Float?
  kassalikviditet       Float?
  antalChefer           Int?    @map("antal_chefer")
  avstandKm             Int?    @map("avstand_km")
  tillagd               String? // ÅÅÅÅ-MM-DD as reported by the harvest

  createdAt    DateTime  @default(now()) @map("created_at")
  processedAt  DateTime? @map("processed_at")
  processError String?   @map("process_error") @db.Text

  signalRef Signal?

  @@index([processedAt])
  @@map("radar_inbox")
}
